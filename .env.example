# Receiver authentication
RECEIVER_TOKEN=replace-with-a-long-random-value

# Runtime
DATABASE_PATH=./data/bridge.db
LOG_LEVEL=INFO
MIN_VISION_CONFIDENCE=0.95
MIN_STABLE_FRAMES=2
MAX_OBSERVATION_AGE_SECONDS=5
MAX_FUTURE_CLOCK_SKEW_SECONDS=2
DECISION_SOURCE=vision

# PokerAI: use "fake" for a local end-to-end smoke test, then switch to "pokerai".
SOLVER_MODE=fake
POKERAI_API_KEY=
POKERAI_BASE_URL=https://pokerai.bet
POKERAI_TIMEOUT_SECONDS=10
PREFLOP_VERSION=6max
FLOP_VERSION=6max

# The provider returns a mixed strategy. HMAC sampling keeps the choice stable on retries.
SAMPLING_SECRET=replace-with-another-long-random-value

# Telegram
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Open Poker (bot-only platform). Dry-run is the default.
OPENPOKER_ENABLED=false
OPENPOKER_API_KEY=
OPENPOKER_WS_URL=wss://openpoker.ai/ws
OPENPOKER_REST_URL=https://api.openpoker.ai/api
OPENPOKER_BUY_IN=2000
OPENPOKER_AUTO_REBUY=true
AUTO_EXECUTE=false
BOT_ONLY_ACK=
## Standalone webcam service (uvicorn app.vision.api:app --port 8001 --workers 1)
## mock exercises transport but never recognizes cards; live requires a server API key.
VISION_MODE=mock
OPENAI_VISION_MODEL=gpt-4.1-mini
OPENAI_API_KEY=
VISION_TIMEOUT_SECONDS=15
